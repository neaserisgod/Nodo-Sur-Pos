/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

// WinSparkle (auto_updater) lee ProductVersion del .exe y lo compara contra
// el `sparkle:version` del feed, que sale como nombre.build con puntos
// ("1.0.0.2098"). Con FLUTTER_VERSION ("1.0.0+2098") el '+' hacía que el
// feed siempre pareciera más nuevo y la app ofrecía actualizar en bucle
// (spike 2026-09-30). Por eso se arma acá desde los números, siempre con
// puntos y con el build incluido.
#define RC_STR_(x) #x
#define RC_STR(x) RC_STR_(x)
#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_STRING RC_STR(FLUTTER_VERSION_MAJOR) "." RC_STR(FLUTTER_VERSION_MINOR) "." RC_STR(FLUTTER_VERSION_PATCH) "." RC_STR(FLUTTER_VERSION_BUILD)
#else
#define VERSION_AS_STRING "1.0.0.0"
#endif

/////////////////////////////////////////////////////////////////////////////
//
// WinSparkle (auto_updater)
//

// Clave PÚBLICA DSA con la que WinSparkle verifica la firma de cada
// actualización antes de instalarla (README de auto_updater). Es la pareja de
// dsa_priv.pem, que NUNCA está en el repo (ver tool/publicar_release.ps1).
// Si se cambia esta clave, las instalaciones existentes dejan de aceptar
// actualizaciones firmadas con la anterior.
DSAPub      DSAPEM      "../../dsa_pub.pem"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "com.laplazoleta" "\0"
            VALUE "FileDescription", "la_plazoleta" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "la_plazoleta" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 com.laplazoleta. All rights reserved." "\0"
            VALUE "OriginalFilename", "la_plazoleta.exe" "\0"
            VALUE "ProductName", "la_plazoleta" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
